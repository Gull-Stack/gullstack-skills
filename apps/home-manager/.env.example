# Home Manager — copy to .env.local and fill in.
#
# NOTHING here has a working default. An unset variable never means "open" and
# never means "use somebody else's database" — the app says what is missing and
# refuses, which is the only safe behaviour for both.

# ── Storage ────────────────────────────────────────────────────────────────
# Your OWN Supabase project. Run scripts/schema.sql against it once.
# Server-side only: the service role key is never exposed to the browser, and
# every table has RLS on with no anon policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── The house ──────────────────────────────────────────────────────────────
# An IANA timezone. Every date in the app is a day in THIS zone, so a task
# ticked at 11pm files under today rather than tomorrow.
HOME_TZ=America/Denver

# ── The family door (/login) ───────────────────────────────────────────────
# HM_OWNER bootstraps the first owner so a door exists before the database
# does. They still need a code.
HM_OWNER=
# One per person, named after them: HM_PIN_ANNA, HM_PIN_MARY_KATE, …
# The environment always beats the code stored on their roster card, so a code
# can be rotated without a database write.
# HM_PIN_YOURNAME=
# Signs the family cookie. Change it and everybody is signed out.
HM_SECRET=

# ── The team door (/team) ──────────────────────────────────────────────────
# Staff codes normally live on their roster card. Set one here to keep it out
# of the database entirely: HM_TEAM_PIN_ANNA, …
# HM_TEAM_PIN_THEIRNAME=
# Signs the team cookie, separately from the family one.
HM_TEAM_SECRET=
