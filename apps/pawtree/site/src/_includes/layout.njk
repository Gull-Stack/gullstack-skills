<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.brand }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.brand }}",
    "url": "{{ site.url }}",
    "foundingDate": "{{ site.founded }}",
    "description": "{{ site.tagline }}"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" }
      {%- if page.url != "/" %},
      { "@type": "ListItem", "position": 2, "name": "{{ title }}", "item": "{{ site.url }}{{ page.url }}" }
      {%- endif %}
    ]
  }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="container nav-inner">
      <a class="wordmark" href="/">{{ site.brand }}</a>
      <nav aria-label="Main">
        <a href="/guides/">Guides</a>
        <a href="/about/">About</a>
        <a class="nav-cta" href="{{ site.storefrontUrl }}" rel="sponsored">Shop<span class="nav-cta-long"> the recommendations</span></a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container">
      <p class="footer-brand">{{ site.brand }}</p>
      <p class="footer-disclosure">{{ site.disclosure }}</p>
      <p class="footer-note">Nothing here is veterinary advice — for medical concerns, talk to your vet. Questions about the site: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <div class="gullstack-credit">Built by <a href="https://gullstack.com">GullStack</a></div>
    </div>
  </footer>
</body>
</html>
