<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.brand }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%2326382c'/%3E%3Cpath d='M7 15h18a1 1 0 0 1 1 1c0 5-4.5 9-10 9S6 21 6 16a1 1 0 0 1 1-1z' fill='%23f6f4ee'/%3E%3Ccircle cx='12' cy='9' r='2.4' fill='%23cf6a28'/%3E%3Ccircle cx='20' cy='9' r='2.4' fill='%23cf6a28'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/main.js" defer></script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.brand }}",
    "url": "{{ site.url }}",
    "foundingDate": "{{ site.founded }}",
    "description": "{{ site.tagline }}"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" }
      {%- if page.url != "/" %},
      { "@type": "ListItem", "position": 2, "name": "{{ title }}", "item": "{{ site.url }}{{ page.url }}" }
      {%- endif %}
    ]
  }
  </script>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <g id="paw"><ellipse cx="9" cy="11" rx="4.6" ry="6.2" transform="rotate(-14 9 11)"/><ellipse cx="20" cy="8" rx="4.8" ry="6.4"/><ellipse cx="31" cy="11" rx="4.6" ry="6.2" transform="rotate(14 31 11)"/><path d="M20 17.5c-6.8 0-11.6 5-11.6 9.8 0 3.9 2.9 6.7 6.7 6.7 1.9 0 3.4-.6 4.9-.6s3 .6 4.9.6c3.8 0 6.7-2.8 6.7-6.7 0-4.8-4.8-9.8-11.6-9.8z"/></g>
  </defs></svg>
  <div class="read-progress" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="container nav-inner">
      <a class="wordmark" href="/">{{ site.brand }}</a>
      <nav aria-label="Main">
        <a href="/guides/">Guides</a>
        <a href="/about/">About</a>
        <a class="nav-cta" href="{{ site.storefrontUrl }}" rel="sponsored">Shop<span class="nav-cta-long"> the recommendations</span></a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container">
      <p class="footer-giant" aria-hidden="true">{{ site.brand }}</p>
      <p class="footer-disclosure">{{ site.disclosure }}</p>
      <p class="footer-note">Nothing here is veterinary advice — for medical concerns, talk to your vet. Questions about the site: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <div class="gullstack-credit">Built by <a href="https://gullstack.com">GullStack</a></div>
    </div>
  </footer>
</body>
</html>
